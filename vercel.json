{
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "/(.+\\.mp4)",
      "headers": {
        "content-type": "video/mp4",
        "accept-ranges": "bytes",
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.+\\.webm)",
      "headers": {
        "content-type": "video/webm",
        "accept-ranges": "bytes",
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/__server" }
  ]
}
